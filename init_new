#!/bin/sh
# CloudLTE-Snapdragon init — AI 聊天终端
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

echo ''
echo '================================='
echo '  CloudLTE-Snapdragon AI 终端'
echo '  (Linux 5.4 MSM8916 + BusyBox)'
echo '================================='

# 启动内置 Web 服务器 (托管聊天 UI)
echo '[WEB] 启动内置 Web 服务 (80 端口)...'
cd /www
busybox httpd -p 80 -h /www -f &

# 打印访问信息
IP=$(ifconfig 2>/dev/null | grep -oE 'inet [0-9.]+' | grep -v 127 | head -1 | cut -d' ' -f2)
echo "[WEB] 访问地址: http://$IP  (或本机 http://127.0.0.1)"
echo '[WEB] 浏览器打开后点 ⚙️ 配置 DeepSeek API Key'
echo ''
echo 'Booting... init OK'
echo ''
exec /bin/sh
